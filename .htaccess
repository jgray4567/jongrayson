# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Ensure sitemap.xml and llms.txt are served with correct content types
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# Canonical redirect: jongrayson.com -> www.jongrayson.com
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^jongrayson\.com [NC]
  RewriteRule ^(.*)$ https://www.jongrayson.com/$1 [R=301,L]
</IfModule>

# Asset caching.
# The server default was 30 days on css/js while index.html expired in 10
# minutes, so returning visitors got new markup against a stale stylesheet
# and script. Revalidate css/js daily; the markup references them with a
# ?v= string, so a real change is picked up immediately either way.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|svg|ico|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
